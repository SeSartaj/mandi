# Production defaults. Run ./scripts/setup.sh --production and set domains/emails.
COMPOSE_PROJECT_NAME=mandi
ENVIRONMENT=production
BIND_ADDRESS=0.0.0.0
MANDI_DOMAIN=mandi.example.org
ODK_DOMAIN=collect.example.org
PUBLIC_COLLECTION_URL=https://collect.example.org
# Leave empty in production: phones use the public HTTPS domain.
LAN_HTTP_HOST=
HTTP_PORT=80
HTTPS_PORT=443
TLS_ISSUER=admin@example.org
SYSADMIN_EMAIL=admin@example.org
CENTRAL_VERSION=2026.3.1
CENTRAL_COMMIT=7d6de621955c5bb6a68e098ca10c9cbb92285cdf
POSTGRES_PASSWORD=
ODK_DB_PASSWORD=
DJANGO_SECRET_KEY=
ODK_ADMIN_EMAIL=admin@example.org
ODK_ADMIN_PASSWORD=
ODK_EMAIL=mandi-service@example.org
ODK_PASSWORD=
ODK_PROJECT_ID=1
COLLECTION_SYNC_INTERVAL=60
MANDI_SYNC_USERNAME=
MANDI_ADMIN_USERNAME=admin
MANDI_ADMIN_EMAIL=admin@example.org
MANDI_ADMIN_PASSWORD=
RELEASE=local
BLUE_RELEASE=local
GREEN_RELEASE=local
