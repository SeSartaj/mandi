DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Omit POSTGRES_DB for the optional SQLite local review mode.
POSTGRES_DB=mandi
POSTGRES_USER=mandi
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Collection provider (ODK Central).
COLLECTION_PROVIDER=odk
ODK_ENTITY_LIST=establishments
ODK_ENTITY_BATCH_SIZE=250
ENTITY_SYNC_INTERVAL=300

# Licensing registry (the single external application registry). Use the
# deployed origin; keep the key server-side only.
LICENSING_BASE_URL=http://192.168.1.4:8008
LICENSING_REGISTRATION_API_KEY=
LICENSING_TIMEOUT=15
LICENSING_SYNC_ENABLED=1
LICENSING_SYNC_INTERVAL=60
LICENSING_SYNC_PAGE_SIZE=50

# Survey registrations (pharmacies and wholesalers). The key must match the
# Survey deployment's REGISTRATION_INTEGRATION_API_KEY.
SURVEY_BASE_URL=
SURVEY_REGISTRATION_API_KEY=
SURVEY_TIMEOUT=15
SURVEY_SYNC_ENABLED=1
SURVEY_SYNC_INTERVAL=300
SURVEY_SYNC_PAGE_SIZE=50
