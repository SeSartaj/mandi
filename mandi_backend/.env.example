DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Omit POSTGRES_DB for the optional SQLite local review mode.
POSTGRES_DB=mandi
POSTGRES_USER=mandi
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Collection provider (ODK Central).
COLLECTION_PROVIDER=odk
ODK_ENTITY_LIST=establishments
ODK_ENTITY_BATCH_SIZE=250
ENTITY_SYNC_INTERVAL=300

# Licensing registry. Use the production origin; keep the key server-side only.
LICENSING_BASE_URL=https://licensing.example.com
LICENSING_REGISTRATION_API_KEY=
LICENSING_TIMEOUT=15

# Separate establishment registry. Keep the key on the server only.
# Supports the documented /api/applications/{category}/registration/ endpoints.
REGISTRATION_BASE_URL=
REGISTRATION_API_KEY=
REGISTRATION_TIMEOUT=15
REGISTRATION_SYNC_ENABLED=1
REGISTRATION_SYNC_INTERVAL=60
REGISTRATION_SYNC_PAGE_SIZE=50
