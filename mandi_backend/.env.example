DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DEMO_INTEGRATIONS=1
# Omit POSTGRES_DB for the optional SQLite local review mode.
POSTGRES_DB=mandi
POSTGRES_USER=mandi
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Local kobo-install / kpi. In this environment nginx is on localhost and
# kf.kobo.local is supplied as the Host header. Leave the token empty to
# disable checklist deployment.
KOBO_BASE_URL=http://127.0.0.1
KOBO_HOST_HEADER=kf.kobo.local
KOBO_API_TOKEN=
KOBO_VERIFY_TLS=0
KOBO_TIMEOUT=30
KOBO_POLL_INTERVAL=1
KOBO_POLL_TIMEOUT=60
