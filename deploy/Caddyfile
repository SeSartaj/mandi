{
	email {$SYSADMIN_EMAIL}
	http_port {$HTTP_PORT}
	https_port {$HTTPS_PORT}
}
{$MANDI_DOMAIN}:{$HTTPS_PORT} {
	tls {$TLS_ISSUER}
	encode zstd gzip
	import /etc/caddy/routes/mandi.caddy
}
{$ODK_DOMAIN}:{$HTTPS_PORT} {
	tls {$TLS_ISSUER}
	reverse_proxy central-web:80
}

# Optional plain-HTTP Central route for phones on the LAN. Empty/disabled in
# production; generated by scripts/setup.sh from LAN_HTTP_HOST.
import /etc/caddy/routes/lan.caddy
