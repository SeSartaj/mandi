# Local defaults. Generate passwords with ./scripts/setup.sh.
COMPOSE_PROJECT_NAME=mandi
ENVIRONMENT=local
BIND_ADDRESS=127.0.0.1
MANDI_DOMAIN=mandi.localhost
ODK_DOMAIN=collect.localhost
# Public base URL Central puts in form/download links and Mandi issues to devices.
PUBLIC_COLLECTION_URL=https://collect.localhost:8443
# Optional plain-HTTP Central host for phones on the same LAN (empty = disabled).
LAN_HTTP_HOST=
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_ISSUER=internal
SYSADMIN_EMAIL=admin@example.invalid
CENTRAL_VERSION=2026.3.1
CENTRAL_COMMIT=7d6de621955c5bb6a68e098ca10c9cbb92285cdf
POSTGRES_PASSWORD=
ODK_DB_PASSWORD=
DJANGO_SECRET_KEY=
ODK_ADMIN_EMAIL=admin@example.invalid
ODK_ADMIN_PASSWORD=
ODK_EMAIL=mandi-service@example.invalid
ODK_PASSWORD=
ODK_PROJECT_ID=1
COLLECTION_SYNC_INTERVAL=60
MANDI_SYNC_USERNAME=
MANDI_ADMIN_USERNAME=admin
MANDI_ADMIN_EMAIL=admin@example.invalid
MANDI_ADMIN_PASSWORD=
RELEASE=local
BLUE_RELEASE=local
GREEN_RELEASE=local

# Licensing registry (the single external application registry). Supports the
# documented /api/applications/{category}/registration/ endpoints. Keep the key
# on the server only. This is the deployed system, not a developer's local one.
LICENSING_BASE_URL=http://192.168.1.4:8008
LICENSING_REGISTRATION_API_KEY=
LICENSING_TIMEOUT=15
LICENSING_SYNC_ENABLED=1
LICENSING_SYNC_INTERVAL=60
LICENSING_SYNC_PAGE_SIZE=50
